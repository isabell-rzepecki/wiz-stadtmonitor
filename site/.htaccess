# Webserver der Subdomain (Plesk, Apache). GitHub Pages liest diese Datei nicht.
# Seiten bringen ihre Content-Security-Policy selbst mit (meta); hier nur, was eine statische Seite zusätzlich braucht.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/octet-stream .pmtiles
  AddType application/geo+json .geojson
  AddCharset utf-8 .html .js .css .json .geojson .webmanifest .tsv .md
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"
  # Daten ändern sich täglich: kurz zwischenspeichern; Schriften und Bibliotheken länger
  <FilesMatch "\.(json|geojson|pmtiles|html|js|css|tsv|webmanifest)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
  <FilesMatch "\.(woff2|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Service Worker der Erfassung immer frisch, damit Aktualisierungen ankommen
  <Files "erfassen-sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Rohdaten und Hilfsdateien, die nie auf dem Server liegen sollen, sicherheitshalber sperren
<FilesMatch "\.(sealed|age|bin|py|sh)$">
  Require all denied
</FilesMatch>
